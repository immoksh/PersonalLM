# Copy to .env and adjust. Loaded by the server at startup.
NODE_ENV=development

# --- Server ---
PORT=4000

CLIENT_ORIGIN=http://localhost:5173

# --- Auth ---
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com


DATABASE_FILE=data/app.sqlite
UPLOAD_DIR=data/uploads

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=personallm_sources
CHUNK_SIZE=1000
CHUNK_OVERLAP=150


RETRIEVAL_TOP_K=8
RETRIEVAL_FINAL_K=6
RETRIEVAL_RRF_K=60
RETRIEVAL_SUB_QUERIES=3

REDIS_URL=redis://localhost:6379
INGEST_CONCURRENCY=2
EMBED_BATCH_SIZE=64
EMBED_CONCURRENCY=4
INGEST_INLINE_WORKER=true
